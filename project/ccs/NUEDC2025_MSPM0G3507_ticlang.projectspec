_sections             -L${CG_TOOL_ROOT}/lib             -llibc.a             --stack_size=4096             --heap_size=1024         " sysConfigBuildOptions="             --output .             --product ${REPO_ROOT}/third_party/mspm0-sdk/.metadata/product.json             --compiler ticlang         " sourceLookupPath="${REPO_ROOT}/third_party/mspm0-sdk/source/ti/driverlib" description="Layered NUEDC2025 MSPM0 project for direct CCS import">
