<?xml version="1.0" encoding="UTF-8"?>
<projectSpec>
    <applicability>
        <when><context deviceFamily="ARM" deviceId="MSPM0G3507" /></when>
    </applicability>
    <project
        title="NUEDC2025_MSPM0"
        name="NUEDC2025_MSPM0G3507_nortos_ticlang"
        configurations="Debug"
        toolChain="TICLANG"
        connection="segger_j-link_connection.xml"
        device="MSPM0G3507"
        ignoreDefaultDeviceSettings="true"
        ignoreDefaultCCSSettings="true"
        products="MSPM0-SDK;sysconfig"
        compilerBuildOptions="
            -I${REPO_ROOT}
            -I${PROJECT_ROOT}/${ConfigName}
            -I${REPO_ROOT}/app
            -I${REPO_ROOT}/core
            -I${REPO_ROOT}/middleware/runtime
            -I${REPO_ROOT}/middleware/system
            -I${REPO_ROOT}/bsp/common
            -I${REPO_ROOT}/bsp/imu
            -I${REPO_ROOT}/bsp/key
            -I${REPO_ROOT}/bsp/laser
            -I${REPO_ROOT}/bsp/motor
            -I${REPO_ROOT}/bsp/oled
            -I${REPO_ROOT}/bsp/step_motor
            -I${REPO_ROOT}/bsp/tracking_sensor
            -I${REPO_ROOT}/board/sys_config
            -O0
            @device.opt
            -I${COM_TI_MSPM0_SDK_INSTALL_DIR}/source/third_party/CMSIS/Core/Include
            -I${COM_TI_MSPM0_SDK_INSTALL_DIR}/source
            -gdwarf-3
            -mcpu=cortex-m0plus
            -march=thumbv6m
            -mfloat-abi=soft
            -mthumb
        "
        linkerBuildOptions="
            -ldevice.cmd.genlibs
            -L${COM_TI_MSPM0_SDK_INSTALL_DIR}/source
            -L${REPO_ROOT}
            -L${PROJECT_BUILD_DIR}/syscfg
            -Wl,--rom_model
            -Wl,--warn_sections
            -L${CG_TOOL_ROOT}/lib
            -llibc.a
            --stack_size=4096
            --heap_size=1024
        "
        sysConfigBuildOptions="
            --output .
            --product ${COM_TI_MSPM0_SDK_INSTALL_DIR}/.metadata/product.json
            --compiler ticlang
        "
        sourceLookupPath="${COM_TI_MSPM0_SDK_INSTALL_DIR}/source/ti/driverlib"
        description="Layered NUEDC2025 MSPM0 project for direct CCS import">
        <property name="buildProfile" value="debug"/>
        <property name="isHybrid" value="true"/>
        <pathVariable name="REPO_ROOT" path="../.." scope="project" />
        <file path="${REPO_ROOT}/app/main.c" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/board/sys_config/empty.syscfg" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/board/sys_config/ti_msp_dl_config.c" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/board/sys_config/ti_msp_dl_config.h" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/middleware/runtime/system_error_state.h" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/middleware/runtime/system_time.h" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/middleware/runtime/tracking_runtime.h" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/middleware/runtime/vision_state.h" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/middleware/runtime/project_build_config.h" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/middleware/system/delay.c" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/middleware/system/delay.h" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/middleware/system/error_handler.c" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/middleware/system/error_handler.h" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/middleware/system/motor_system.c" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/middleware/system/motor_system.h" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/middleware/system/step_motor_system.c" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/middleware/system/step_motor_system.h" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/core/kinematics.c" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/core/kinematics.h" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/core/pid.c" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/core/pid.h" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/core/rotation.c" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/core/rotation.h" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/core/sensor_proc.c" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/core/sensor_proc.h" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/core/step_motor_ctrl.c" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/core/step_motor_ctrl.h" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/core/tracking.c" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/core/tracking.h" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/app/app_launcher.c" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/app/app_launcher.h" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/app/circle_list.c" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/app/circle_list.h" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/app/menu.c" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/app/menu.h" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/app/mode.c" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/app/mode.h" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/app/mode_tree.c" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/app/mode_tree.h" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/bsp/common/bsp_common.h" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/bsp/imu/reg.h" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/bsp/imu/wit_sdk.c" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/bsp/imu/wit_sdk.h" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/bsp/key/key.c" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/bsp/key/key.h" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/bsp/laser/laser_usart.c" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/bsp/laser/laser_usart.h" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/bsp/motor/hall_encoder.c" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/bsp/motor/hall_encoder.h" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/bsp/motor/tb6612fng.c" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/bsp/motor/tb6612fng.h" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/bsp/oled/oled.c" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/bsp/oled/oled.h" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/bsp/oled/oled_font.h" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/bsp/step_motor/step_motor.c" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/bsp/step_motor/step_motor.h" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/bsp/tracking_sensor/tracking_sensor.c" openOnCreation="false" excludeFromBuild="false" action="link" />
        <file path="${REPO_ROOT}/bsp/tracking_sensor/tracking_sensor.h" openOnCreation="false" excludeFromBuild="false" action="link" />
    </project>
</projectSpec>